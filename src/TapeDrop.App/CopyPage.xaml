<Page
    x:Class="TapeDrop.Desktop.CopyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Copy to tape" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar x:Name="DemoBar" Grid.Row="1" Severity="Informational" IsClosable="False" IsOpen="False"
                 Title="Demo mode" />

        <Border x:Name="DropZone" Grid.Row="2"
                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                BorderThickness="2" CornerRadius="12"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE896;" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag files and folders here" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="From your USB RAID or anywhere else" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="StagedList" Visibility="Collapsed" Padding="12" SelectionMode="None" />
            </Grid>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Text="Nothing added yet" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
            <TextBox x:Name="NameBox" Header="Job name (optional)" Width="260" />
            <ToggleSwitch x:Name="VerifyToggle" Header="Verify after writing" IsOn="True" />
            <ToggleSwitch x:Name="EjectToggle" Header="Eject when done" />
            <Button x:Name="CopyButton" Content="Copy to tape" Style="{StaticResource AccentButtonStyle}"
                    Click="CopyButton_Click" IsEnabled="False" VerticalAlignment="Bottom" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                    Visibility="Collapsed" VerticalAlignment="Bottom" />
            <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" VerticalAlignment="Bottom" />
        </StackPanel>

        <StackPanel Grid.Row="5" Spacing="6">
            <ProgressBar x:Name="JobProgress" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Opacity="0.8" />
        </StackPanel>
    </Grid>
</Page>
