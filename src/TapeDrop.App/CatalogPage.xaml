<Page
    x:Class="TapeDrop.Desktop.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catalog" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="SearchBox" Width="420" PlaceholderText="Search for a file name or folder"
                     KeyDown="SearchBox_KeyDown" />
            <Button Content="Search" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="ResultsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="HintText"
                       Text="Search shows which tape holds a file. To get it back, insert that tape, mount it, and copy the file out in Explorer."
                       TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
